# Server
APP_NAME="AI Toolkit API"
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1

# BiRefNet — model id on Hugging Face Hub
BIREFNET_MODEL_ID=ZhengPeng7/BiRefNet_lite
BIREFNET_INPUT_SIZE=1024

# Enhancer — cap input longest side on CPU (0 = no cap)
ENHANCER_MAX_INPUT_SIDE=0

# Upload limits
MAX_UPLOAD_MB=25
