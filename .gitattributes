# Normalize to LF in the repository. Shell scripts, systemd units and nginx
# configs are consumed on Linux — CRLF would break them (`$'\r': command not
# found`), and this repo is authored on Windows.
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.conf    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.py      text eol=lf
